  <diagram name="Page-1" id="gnHZIVCD_BXD6Ym0lYXN">
    <mxGraphModel dx="3003" dy="1558" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n\n    A([Inicio: material identificado o recepcionado]) --&gt; B{¿Es Producto Terminado?}\n\n    B -- No --&gt; Z1([Fuera del alcance del proceso])\n    B -- Sí --&gt; C{¿Cuál es el origen de entrada?}\n\n    C -- Marcado por Calidad --&gt; C1[Restricción aplicada por Calidad]\n    C -- Devolución --&gt; C2[Material procedente de devolución]\n    C -- Obsoleto liberado --&gt; C3[Material obsoleto liberado]\n    C -- Recepción desde otro centro --&gt; C4{¿Llega marcado desde origen con calidad 8?}\n\n    C4 -- No --&gt; Z2([Continuar mediante el flujo ordinario])\n    C4 -- Sí --&gt; D[Incorporar al circuito restringido]\n\n    C1 --&gt; E[Asignar o mantener Limited Sales]\n    C2 --&gt; E\n    C3 --&gt; E\n    D --&gt; E\n\n    E --&gt; E1[\&quot;Valores actuales:&lt;br/&gt;0 = Sin restricción&lt;br/&gt;1 = Aplicado por Calidad&lt;br/&gt;2 = Devolución&lt;br/&gt;3 = Obsoleto liberado\&quot;]\n    E1 --&gt; E2[\&quot;¿Crear Limited Sales = 4&lt;br/&gt;o reutilizar Limited Sales = 1?&lt;br/&gt;Pendiente de confirmar\&quot;]\n\n    E2 --&gt; F[Conservar inicialmente la calidad SAP]\n    F --&gt; F1[\&quot;Limited Sales identifica la restricción comercial.&lt;br/&gt;No implica liberar ni cambiar automáticamente la calidad.\&quot;]\n\n    F1 --&gt; G{¿Dónde está el material?}\n\n    subgraph MK[\&quot;Material en MK\&quot;]\n        G -- MK --&gt; H[Conservar ubicación y calidad actuales]\n        H --&gt; I[Identificar el material mediante Limited Sales en ViscoStock]\n        I --&gt; J[\&quot;Consulta disponible en ViscoStock&lt;br/&gt;Posible BI pendiente de valorar\&quot;]\n        J --&gt; K{¿El material retorna a ITU?}\n        K -- No --&gt; L([Permanece identificado en MK])\n        K -- Sí --&gt; M[\&quot;Consultar movimientos del ítem&lt;br/&gt;en ViscoStock.TSTKArticlesHist\&quot;]\n        M --&gt; N[Obtener el último almacén nacional]\n        N --&gt; O{¿Pertenece al circuito del nuevo almacén?}\n        O -- No --&gt; P[Aplicar lógica ordinaria basada en el histórico]\n        P --&gt; Z3([Material dirigido al almacén nacional correspondiente])\n        O -- Sí --&gt; Q[\&quot;Dirigir el material al nuevo almacén&lt;br/&gt;de ITU\&quot;]\n        Q --&gt; Q1[\&quot;¿Entrada directa o movimiento 311?&lt;br/&gt;Pendiente de confirmar\&quot;]\n    end\n\n    subgraph ITU[\&quot;Material en ITU\&quot;]\n        G -- ITU --&gt; R{¿Cómo se realizará el movimiento?}\n        R -- Opción automática --&gt; S[ViscoStock genera o gestiona el movimiento]\n        R -- Opción manual --&gt; T[Un usuario realiza el movimiento]\n        R -. \&quot;Negocio debe escoger&lt;br/&gt;la opción a desarrollar\&quot; .-&gt; R1[\&quot;Decisión pendiente de Negocio\&quot;]\n        S --&gt; U[Material ubicado en el nuevo almacén lógico o virtual]\n        T --&gt; U\n        Q1 --&gt; U\n    end\n\n    U --&gt; V[\&quot;Visibilidad del material:&lt;br/&gt;SAP + ViscoStock&lt;br/&gt;Posible BI pendiente de valorar\&quot;]\n    V --&gt; W[\&quot;Tratamiento MRP:&lt;br/&gt;en principio, el almacén no debe cubrir la necesidad&lt;br/&gt;si no existe stock disponible en otros almacenes\&quot;]\n    W --&gt; X{¿Calidad decide liberar el material?}\n\n    X -- No --&gt; Y([Material permanece restringido en el nuevo almacén])\n    X -- Sí --&gt; AA[Actualizar la calidad según el procedimiento aplicable]\n\n    AA --&gt; AB[\&quot;Generar la entrega indicando&lt;br/&gt;el nuevo almacén lógico o virtual\&quot;]\n    AB --&gt; AC[\&quot;ViscoStock selecciona el material por:&lt;br/&gt;almacén + calidad 1, 2, 7 u 8 + material + lote + FIFO restrictivo\&quot;]\n\n    AC --&gt; AD{\&quot;¿Cliente autorizado para recibir&lt;br/&gt;este material restringido?&lt;br/&gt;?\&quot;}\n\n    AD -- \&quot;Pendiente de definir\&quot; --&gt; AE[\&quot;Regla de autorización de clientes&lt;br/&gt;Pendiente de confirmar por Negocio\&quot;]\n    AE --&gt; AF{¿La preparación es compatible?}\n\n    AD -- Sí --&gt; AF\n    AD -- No --&gt; AG[ViscoStock bloquea la preparación]\n\n    AF -- No --&gt; AG\n    AF -- Sí --&gt; AH[Continuar con los pasos intermedios de preparación]\n\n    AG --&gt; AI[\&quot;No permitir escanear el material&lt;br/&gt;ni validar el envío\&quot;]\n    AI --&gt; Z4([Preparación bloqueada])\n\n    AH --&gt; AJ{¿Validaciones superadas?}\n    AJ -- No --&gt; AG\n    AJ -- Sí --&gt; AK[Validar y expedir el material]\n    AK --&gt; AL[Dar de baja el stock del nuevo almacén]\n    AL --&gt; Z5([Fin: material expedido])\n\n    U --&gt; AM{¿El material abandona el almacén&lt;br/&gt;sin ser expedido?}\n    AM -- Traslado a MK --&gt; AN[Transferir el material al almacén externo MK]\n    AN --&gt; I\n    AM -- Movimiento manual por error --&gt; AO[\&quot;Movimiento incorrecto&lt;br/&gt;Tratamiento pendiente de confirmar\&quot;]\n    AO --&gt; Z6([Excepción pendiente de resolución])\n    AM -- No --&gt; X&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="RZ5YMTX3csaYCtqtk_9E-1">
